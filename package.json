{
  "name": "roteiro-viagem-italia",
  "private": true,
  "version": "1.0.0",
  "description": "Roteiro de viagem pela Itália (app de um arquivo HTML) com testes automatizados de front-end.",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:visual:update": "playwright test tests/visual.spec.js --update-snapshots",
    "test:report": "playwright show-report",
    "prepare": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
